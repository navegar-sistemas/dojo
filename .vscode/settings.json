{
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
    "peacock.color": "#832561",
    "python.defaultInterpreterPath": "${workspaceFolder}/python/a-maze-ing/tests/.venv/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.cwd": "${workspaceFolder}/python/a-maze-ing/tests",
    "python.testing.pytestArgs": [
        "${workspaceFolder}/python/a-maze-ing/tests"
    ],
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#ab307e",
        "activityBar.background": "#ab307e",
        "activityBar.foreground": "#e7e7e7",
        "activityBar.inactiveForeground": "#e7e7e799",
        "activityBarBadge.background": "#25320e",
        "activityBarBadge.foreground": "#e7e7e7",
        "activityBarTop.activeBackground": "#ab307e",
        "activityBarTop.background": "#ab307e",
        "activityBarTop.foreground": "#e7e7e7",
        "activityBarTop.inactiveForeground": "#e7e7e799",
        "commandCenter.border": "#e7e7e799",
        "commandCenter.foreground": "#e7e7e7",
        "sash.hoverBorder": "#ab307e",
        "statusBar.background": "#832561",
        "statusBar.debuggingBackground": "#832561",
        "statusBar.debuggingForeground": "#e7e7e7",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#ab307e",
        "statusBarItem.remoteBackground": "#121907",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#832561",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#83256199",
        "titleBar.inactiveForeground": "#e7e7e799",
        "activityBar.activeBorder": "#e7e7e7",
        "activityBarTop.activeBorder": "#e7e7e7",
        "statusBar.inactiveBackground": "#832561"
    },
    "cucumber.features": [
        "python/a-maze-ing/tests/features/**/*.feature"
    ],
    "cucumber.glue": [
        "python/a-maze-ing/tests/step_defs/**/*.py"
    ],
    "cucumber.parameterTypes": [
        {
            "name": "nome:Q",
            "regexp": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "definicao:Q",
            "regexp": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "texto:Q",
            "regexp": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "arquivo:Q",
            "regexp": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "caminho:Q",
            "regexp": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "comando:Q",
            "regexp": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "comandos:L",
            "regexp": "\"(?:[^\"\\\\]|\\\\.)*\"(?:(?:, | e )\"(?:[^\"\\\\]|\\\\.)*\")*"
        },
        {
            "name": "textos:L",
            "regexp": "\"(?:[^\"\\\\]|\\\\.)*\"(?:(?:, | e )\"(?:[^\"\\\\]|\\\\.)*\")*"
        },
        {
            "name": "alvos:L",
            "regexp": "\"(?:[^\"\\\\]|\\\\.)*\"(?:(?:, | e )\"(?:[^\"\\\\]|\\\\.)*\")*"
        },
        {
            "name": "codigo:d",
            "regexp": "-?\\d+"
        },
        {
            "name": "fluxo:Fluxo",
            "regexp": "a saída de erro|a saída padrão|a saída"
        },
        {
            "name": "verbo:Contem",
            "regexp": "não contém|contém"
        },
        {
            "name": "situacao:EstadoCaminho",
            "regexp": "não é ignorado pelo git|está versionado no git|é ignorado pelo git|não está vazio|não existe|existe"
        },
        {
            "name": "tipo:Q",
            "regexp": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "a:Q",
            "regexp": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "b:Q",
            "regexp": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "linhas:L",
            "regexp": "\"(?:[^\"\\\\]|\\\\.)*\"(?:(?:, | e )\"(?:[^\"\\\\]|\\\\.)*\")*"
        },
        {
            "name": "origem:Origem",
            "regexp": "do repositório|base"
        },
        {
            "name": "situacao:Q",
            "regexp": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "resultado:Q",
            "regexp": "(?:[^\"\\\\]|\\\\.)*"
        }
    ]
}
